# Base URL of the content API (the future admin dashboard backend).
# When empty, the site uses the bundled seed content in src/data.
# The API is expected to expose GET {VITE_API_BASE_URL}/content returning the same shape as src/data/index.js.
VITE_API_BASE_URL=

# Endpoint that receives contact-form enquiries (POST, JSON body).
# When empty, submissions are simulated in development.
VITE_CONTACT_ENDPOINT=
